{
  "name": "ci-pipeline-node",
  "version": "1.0.0",
  "description": "Continuous Integration pipeline with automated testing",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "node --check src/server.js && node --check src/app.js && node --check src/productService.js && node --check src/productRepository.js && node --check src/consumer.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:contract": "jest tests/contract --runInBand",
    "test:db": "jest tests/database --runInBand",
    "test:ci": "npm run build && npm test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.4",
    "@testcontainers/postgresql": "^12.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
